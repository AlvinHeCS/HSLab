# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# Generate a new secret with: npx auth secret
AUTH_SECRET=""

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (local dev)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Prisma — points at the docker container started by ./start-database.sh
DATABASE_URL="postgresql://postgres:password@localhost:5432/hslab"

# Supabase — connect via the Vercel→Supabase integration in production; values
# below are for local dev. The service-role key is server-only (never exposed to
# the client). Image uploads for question authoring use the question-images
# bucket via signed upload URLs minted server-side.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
