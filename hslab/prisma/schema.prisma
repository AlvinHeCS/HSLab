// HSLab — HSC Math practice platform
// Schema locked in /grill-me session. Do not edit fields without re-grilling.
//
// Conventions:
// - IDs: cuid (matches T3 / NextAuth scaffold)
// - Rich content: TipTap JSON in Json fields (text + math + tables + images, in document order)
// - LaTeX: stored inside TipTap math nodes, rendered client-side with KaTeX
// - Images: TipTap image nodes pointing to S3 URLs
// - Math topic/subtopic enums: placeholder values until NESA syllabus is scraped and seeded
// - Hierarchy enforcement (grade→topic→subtopic) lives in src/server/taxonomy.ts, not in DB
//
// Raw-SQL constraints required (see prisma/migrations/manual_constraints.sql):
//   1. friendships:        UNIQUE on unordered pair (LEAST/GREATEST)
//   2. question_responses: CHECK exactly one of (drill_session_id, test_session_id, battle_match_id) is non-null

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

