enum QuestionDifficulty {
    easy
    medium
    hard
}

enum QuestionStatus {
    draft
    review
    published
}

enum QuestionType {
    mcq
    numeric
    short_text
}

enum FriendshipStatus {
    pending
    accepted
    rejected
}

enum BattleStatus {
    waiting       // invite accepted, match created, awaiting both players ready
    active        // in progress
    completed
    abandoned     // one player disconnected / forfeited
}

enum BattleInviteStatus {
    pending
    accepted
    declined
    expired
}

enum DrillSessionMode {
    topic_drill
    mistake_review
}

enum DrillEndedReason {
    explicit
    idle_timeout
}

enum TestEndedReason {
    submitted
    time_expired
    forfeit       // tab closed
}

enum ReportCategory {
    wrong_answer
    typo
    image_broken
    ambiguous
    off_topic
    other
}

enum ReportStatus {
    open
    resolved
    dismissed
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH (NextAuth Prisma adapter — standard tables)
// ─────────────────────────────────────────────────────────────────────────────

model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String?
    access_token             String?
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String?
    session_state            String?
    refresh_token_expires_in Int?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
    id            String    @id @default(cuid())
    email         String    @unique
    emailVerified DateTime?
    passwordHash  String?   // null for OAuth-only accounts
    displayName   String
    username      String    @unique
    avatarUrl     String?   // from Google
    avatarColor   String    // fallback hex, e.g. "#FF6B6B"
    friendCode    String    @unique // short generated code (e.g. ABCD-1234)
    role          Role      @default(student)
    grade         Grade?    // default filter for drills/tests; nullable until onboarding done
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    accounts Account[]
    sessions Session[]

    friendshipsSent     Friendship[] @relation("FriendshipRequester")
    friendshipsReceived Friendship[] @relation("FriendshipReceiver")

    drillSessions DrillSession[]
    testSessions  TestSession[]

    battleMatchesAsP1 BattleMatch[] @relation("BattlePlayer1")
    battleMatchesAsP2 BattleMatch[] @relation("BattlePlayer2")

    battleInvitesSent     BattleInvite[] @relation("BattleInviter")
    battleInvitesReceived BattleInvite[] @relation("BattleInvitee")

    questionResponses QuestionResponse[]
    savedQuestions    SavedQuestion[]
    questionReports   QuestionReport[]
    reportComments    ReportComment[]    @relation("ReportCommentAuthor")

    questionsCreated  Question[]      @relation("QuestionCreatedBy")
    blueprintsCreated TestBlueprint[] @relation("BlueprintCreatedBy")
    reportsResolved   QuestionReport[] @relation("ReportResolvedBy")

    @@index([username])
    @@index([friendCode])
}

// ─────────────────────────────────────────────────────────────────────────────
// FRIENDSHIPS
// ─────────────────────────────────────────────────────────────────────────────
// NOTE: Prisma cannot enforce unique unordered-pair (A,B == B,A). A raw-SQL
// migration creates: CREATE UNIQUE INDEX friendships_pair_uniq ON friendships
//   (LEAST(requester_id, receiver_id), GREATEST(requester_id, receiver_id));

model Friendship {
    id          String           @id @default(cuid())
    requesterId String
    receiverId  String
    status      FriendshipStatus @default(pending)
    createdAt   DateTime         @default(now())
    acceptedAt  DateTime?
    updatedAt   DateTime         @updatedAt

    requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
    receiver  User @relation("FriendshipReceiver",  fields: [receiverId],  references: [id], onDelete: Cascade)

    @@index([requesterId, status])
    @@index([receiverId,  status])
}

// ─────────────────────────────────────────────────────────────────────────────
// QUESTIONS  (one stimulus + 1..N parts)
// ─────────────────────────────────────────────────────────────────────────────

model Question {
    id          String             @id @default(cuid())
    grade       Grade
    topic       MathTopic
    subtopic    MathSubtopic
    difficulty  QuestionDifficulty
    status      QuestionStatus     @default(draft)
    isActive    Boolean            @default(true) // soft-hide for published; published+inactive = retired
    stimulusDoc Json?              // TipTap doc — null if question has no shared stimulus (single-part flat)
    createdAt   DateTime           @default(now())
    updatedAt   DateTime           @updatedAt

    createdById String
    createdBy   User   @relation("QuestionCreatedBy", fields: [createdById], references: [id])

    parts   QuestionPart[]
    savedBy SavedQuestion[]
    reports QuestionReport[]

    @@index([status, isActive, grade, topic, subtopic, difficulty])
    @@index([status, isActive, grade, difficulty])
}

model QuestionPart {
    id                String       @id @default(cuid())
    questionId        String
    orderIndex        Int          // 0, 1, 2 → rendered as (a), (b), (c) when parts.length > 1
    isStandalone      Boolean      @default(false) // true → eligible for battles + standalone drills
    questionType      QuestionType
    promptDoc         Json         // TipTap doc
    explanationDoc    Json?        // TipTap doc, optional
    correctAnswer     String       // canonical; for MCQ this is choice label "A"/"B"/...
    choices           Json?        // MCQ only: [{label:"A", doc:{...tiptap...}}, ...]
    toleranceOverride Float?       // numeric only: override default tolerance rule
    createdAt         DateTime     @default(now())
    updatedAt         DateTime     @updatedAt

    question  Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
    responses QuestionResponse[]

    @@unique([questionId, orderIndex])
    @@index([questionId])
    @@index([isStandalone])
}

// ─────────────────────────────────────────────────────────────────────────────
// DRILL SESSIONS  (Khan-style infinite stream, heartbeat-pinged close)
// ─────────────────────────────────────────────────────────────────────────────

model DrillSession {
    id              String              @id @default(cuid())
    userId          String
    mode            DrillSessionMode    @default(topic_drill)
    grade           Grade?              // null when mode = mistake_review (mistakes span topics)
    topic           MathTopic?
    subtopic        MathSubtopic?
    difficulty      QuestionDifficulty? // null = mixed
    startedAt       DateTime            @default(now())
    lastHeartbeatAt DateTime            @default(now())
    endedAt         DateTime?
    endedReason     DrillEndedReason?
    totalQuestions  Int                 @default(0)
    correctCount    Int                 @default(0)

    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    responses QuestionResponse[]

    @@index([userId, endedAt])
    @@index([endedAt, lastHeartbeatAt]) // for the heartbeat GC sweep query
}

// ─────────────────────────────────────────────────────────────────────────────
// TESTS  (admin-curated blueprints, end-only review, no pause)
// ─────────────────────────────────────────────────────────────────────────────

model TestBlueprint {
    id               String    @id @default(cuid())
    name             String
    description      String?
    grade            Grade
    timeLimitSeconds Int
    questionPartIds  String[]  // ordered, frozen at publish time
    isActive         Boolean   @default(true)
    publishedAt      DateTime?
    createdAt        DateTime  @default(now())
    updatedAt        DateTime  @updatedAt

    createdById String
    createdBy   User   @relation("BlueprintCreatedBy", fields: [createdById], references: [id])

    sessions TestSession[]

    @@index([grade, isActive])
}

model TestSession {
    id              String           @id @default(cuid())
    userId          String
    blueprintId     String
    questionPartIds String[]         // copied from blueprint at start; frozen even if blueprint changes
    startedAt       DateTime         @default(now())
    endedAt         DateTime?
    endedReason     TestEndedReason?
    totalCorrect    Int              @default(0)

    user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
    blueprint TestBlueprint      @relation(fields: [blueprintId], references: [id])
    responses QuestionResponse[]

    @@index([userId, endedAt])
    @@index([blueprintId])
}

// ─────────────────────────────────────────────────────────────────────────────
// BATTLES  (friends-only, standalone parts only, per-part timer)
// ─────────────────────────────────────────────────────────────────────────────

model BattleInvite {
    id            String             @id @default(cuid())
    inviterId     String
    inviteeId     String
    grade         Grade
    topic         MathTopic?         // null = random topic within grade
    questionCount Int                // 5 | 10 | 20 (validated app-side)
    status        BattleInviteStatus @default(pending)
    matchId       String?            @unique // set when accepted
    createdAt     DateTime           @default(now())
    expiresAt     DateTime           // now() + 5 min, set in app code
    updatedAt     DateTime           @updatedAt

    inviter User         @relation("BattleInviter", fields: [inviterId], references: [id], onDelete: Cascade)
    invitee User         @relation("BattleInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
    match   BattleMatch? @relation(fields: [matchId], references: [id])

    @@index([inviteeId, status])
    @@index([inviterId, status])
}

model BattleMatch {
    id              String       @id @default(cuid())
    player1Id       String
    player2Id       String
    grade           Grade
    topic           MathTopic?   // null only if invite was random and we keep that semantic
    questionCount   Int
    questionPartIds String[]     // ordered, frozen at match creation; both players see same sequence
    status          BattleStatus @default(waiting)

    player1Score             Int       @default(0)
    player2Score             Int       @default(0)
    player1CurrentQIndex     Int?
    player1CurrentQStartedAt DateTime?
    player2CurrentQIndex     Int?
    player2CurrentQStartedAt DateTime?

    createdAt   DateTime  @default(now())
    completedAt DateTime?

    player1   User               @relation("BattlePlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
    player2   User               @relation("BattlePlayer2", fields: [player2Id], references: [id], onDelete: Cascade)
    invite    BattleInvite?
    responses QuestionResponse[]

    @@index([player1Id])
    @@index([player2Id])
    @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// QUESTION RESPONSES  (single source of truth — drill, test, battle all funnel here)
// ─────────────────────────────────────────────────────────────────────────────
// CHECK constraint via raw SQL: exactly one of {drillSessionId, testSessionId, battleMatchId}
// must be non-null. Migration: prisma/migrations/manual_constraints.sql

model QuestionResponse {
    id             String   @id @default(cuid())
    userId         String
    questionPartId String
    selectedAnswer String   // raw user input; for MCQ it's the choice label
    isCorrect      Boolean
    timeSeconds    Int      // wall-clock time spent on this part
    answeredAt     DateTime @default(now())

    drillSessionId String?
    testSessionId  String?
    battleMatchId  String?

    user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    questionPart QuestionPart  @relation(fields: [questionPartId], references: [id], onDelete: Cascade)
    drillSession DrillSession? @relation(fields: [drillSessionId], references: [id], onDelete: Cascade)
    testSession  TestSession?  @relation(fields: [testSessionId],  references: [id], onDelete: Cascade)
    battleMatch  BattleMatch?  @relation(fields: [battleMatchId],  references: [id], onDelete: Cascade)

    @@index([userId, questionPartId, answeredAt(sort: Desc)]) // mistake derivation query
    @@index([userId, isCorrect, answeredAt])
    @@index([drillSessionId])
    @@index([testSessionId])
    @@index([battleMatchId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SAVED QUESTIONS  (simple bookmark, whole question)
// ─────────────────────────────────────────────────────────────────────────────

model SavedQuestion {
    id         String   @id @default(cuid())
    userId     String
    questionId String
    savedAt    DateTime @default(now())

    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

    @@unique([userId, questionId])
    @@index([userId, savedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// QUESTION REPORTS  (categories + free text, 3-state, no auto-hide)
// ─────────────────────────────────────────────────────────────────────────────

model QuestionReport {
    id           String         @id @default(cuid())
    questionId   String
    userId       String
    category     ReportCategory
    text         String?
    status       ReportStatus   @default(open)
    createdAt    DateTime       @default(now())
    resolvedAt   DateTime?
    resolvedById String?

    question   Question        @relation(fields: [questionId],   references: [id], onDelete: Cascade)
    user       User            @relation(fields: [userId],       references: [id], onDelete: Cascade)
    resolvedBy User?           @relation("ReportResolvedBy", fields: [resolvedById], references: [id])
    comments   ReportComment[]

    @@index([status, createdAt])
    @@index([questionId])
    @@index([userId])
}

model ReportComment {
    id        String   @id @default(cuid())
    reportId  String
    userId    String   // admin user who commented
    comment   String
    createdAt DateTime @default(now())

    report QuestionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
    user   User           @relation("ReportCommentAuthor", fields: [userId], references: [id])

    @@index([reportId])
}
